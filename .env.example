# Which LLM backend to use for the LLM methods: ollama, anthropic or openai.
# Local-only mode is the default; hosted backends are only used when ALLOW_HOSTED_LLM=true.
LLM_BACKEND=ollama
ALLOW_HOSTED_LLM=false

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic (hosted, paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI (hosted, paid)
OPENAI_API_KEY=
OPENAI_MODEL=

# Fine-tuned extractive QA model directory
QA_MODEL_DIR=models/qa-deberta-v3-small
